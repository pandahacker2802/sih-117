# AI Agent Configuration Template
# Copy this file to .env.local and fill in your values

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3001
NODE_ENV=development

# ============================================================
# BACKEND INTEGRATION
# ============================================================
# Backend API URL
BACKEND_URL=http://localhost:5000/api

# Backend authentication (if needed)
BACKEND_API_KEY=your-api-key

# ============================================================
# LLM/OLLAMA CONFIGURATION
# ============================================================
# Ollama service URL
OLLAMA_URL=http://localhost:11434/api

# Model name for text generation
OLLAMA_MODEL=gemma:2b

# Model for embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Temperature for generation (0.0-1.0)
OLLAMA_TEMPERATURE=0.7

# Number of tokens to generate
OLLAMA_NUM_PREDICT=512

# ============================================================
# RAG INTEGRATION
# ============================================================
# RAG system URL
RAG_URL=http://localhost:5000/api/rag

# Enable RAG
RAG_ENABLED=true

# ============================================================
# CONTENT GENERATION
# ============================================================
# Default tone for generated content
DEFAULT_TONE=analytical

# Enable LLM for content
USE_LLM=true

# Min/Max variations
MIN_VARIATIONS=1
MAX_VARIATIONS=5

# ============================================================
# API CONFIGURATION
# ============================================================
# API timeout in milliseconds
API_TIMEOUT=30000

# Retry attempts for failed requests
MAX_RETRIES=3

# ============================================================
# LOGGING
# ============================================================
# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable content generation
FEATURE_CONTENT_GENERATION=true

# Enable RAG search
FEATURE_RAG_SEARCH=true

# Enable LLM processing
FEATURE_LLM=true
